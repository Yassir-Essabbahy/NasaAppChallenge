%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe321ce7e9700d345aaaa957a6ced8dc, type: 3}
  m_Name: SourcesDatabase
  m_EditorClassIdentifier: Outpost.Runtime::Outpost.Runtime.Terminal.SourcesDatabase
  Entries:
  - Id: src_dust
    Title: '[Placeholder] Solar Array Dust Accumulation'
    Organization: NASA JPL / Mars Exploration
    UrlText: https://science.nasa.gov/mission/mars-exploration-rovers/
    UsedByConstantsAndEvents: DustAccumulationPerSol, evt_panel_dust
  - Id: src_co2
    Title: '[Placeholder] Cabin CO2 Scrubbing & ECLSS'
    Organization: NASA Human Spaceflight
    UrlText: https://www.nasa.gov/missions/station/eclss/
    UsedByConstantsAndEvents: OxygenGenAtFull, LowScrubberThreshold, evt_scrubber_clog
  - Id: src_storm
    Title: '[Placeholder] Martian Dust Storms & Optical Depth'
    Organization: NASA Mars Science
    UrlText: https://science.nasa.gov/resource/mars-dust-storms/
    UsedByConstantsAndEvents: StormSolarFactor, StormExtraDustPerSol, evt_dust_storm
  - Id: src_rad
    Title: '[Placeholder] Mars Surface Radiation & SPE'
    Organization: NASA / Curiosity RAD
    UrlText: https://science.nasa.gov/mission/msl-curiosity/radiation-assessment-detector/
    UsedByConstantsAndEvents: BaselineSurfaceDoseMsvPerSol, SolarFlareUnshieldedDoseMsv,
      evt_solar_flare
  - Id: src_water
    Title: '[Placeholder] Closed-Loop Water Recovery'
    Organization: NASA MSFC / ISS
    UrlText: https://www.nasa.gov/reference/environmental-control-and-life-support-systems/
    UsedByConstantsAndEvents: WaterGenAtFull, WaterFixedLoss, evt_water_recycler
  - Id: src_crops
    Title: '[Placeholder] Space Crop & Veggie Systems'
    Organization: NASA KSC
    UrlText: https://www.nasa.gov/exploration-research-and-technology/growing-plants-in-space/
    UsedByConstantsAndEvents: FoodGenAtFull, GreenhouseOxygenBonus, evt_greenhouse_blight
  - Id: src_cold
    Title: '[Placeholder] Martian Thermal Environment'
    Organization: NASA GSFC Mars Fact Sheet
    UrlText: https://nssdc.gsfc.nasa.gov/planetary/factsheet/marsfact.html
    UsedByConstantsAndEvents: HeatingSafeThreshold, ColdHealthPenalty, evt_cold_snap
  - Id: src_psych
    Title: '[Placeholder] Isolated Crew Behavioral Health'
    Organization: NASA JSC CHAPEA / HERA
    UrlText: https://www.nasa.gov/humans-in-space/chapea/
    UsedByConstantsAndEvents: LowMoraleThreshold, RationMoraleCost, evt_crew_tension
  - Id: src_comms
    Title: '[Placeholder] Earth-Mars Light-Time Delay'
    Organization: NASA Deep Space Network
    UrlText: https://eyes.nasa.gov/apps/dsn-now/dsn.html
    UsedByConstantsAndEvents: CommsMaxPower, evt_earth_message
  - Id: src_shield
    Title: '[Placeholder] Regolith Shielding & Micrometeoroids'
    Organization: NASA Moon to Mars
    UrlText: https://www.nasa.gov/humans-in-space/radiation/
    UsedByConstantsAndEvents: ShieldingMaxReduction, ReinforceShieldingGain, evt_micrometeorite
